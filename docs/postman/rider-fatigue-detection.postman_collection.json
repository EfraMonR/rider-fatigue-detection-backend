    {
      "name": "IDOR Tests",
      "description": "Pruebas de IDOR (Insecure Direct Object Reference). Flujo:\n1. Registrar user2 con `user_email_2` / `user_password_2`.\n2. Login user2 → guarda `access_token` en la variable `access_token_user2`.\n3. Intentar leer `session_id` de user1 con el token de user2.\n4. Verificar que la respuesta es 404 SESSION_NOT_FOUND.",
      "item": [
        {
          "name": "POST /auth/register — user2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.environment.set('access_token_user2', res.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email_2}}\",\n  \"password\": \"{{user_password_2}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          },
          "response": []
        },
        {
          "name": "POST /auth/login — user2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.environment.set('access_token_user2', res.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email_2}}\",\n  \"password\": \"{{user_password_2}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "response": []
        },
        {
          "name": "GET /history/{id} con token de user2 — debe devolver 404",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token_user2}}" }
            ],
            "url": {
              "raw": "{{base_url}}/history/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["history", "{{session_id}}"]
            },
            "description": "`session_id` pertenece a user1. El token de user2 no debe tener acceso.\nRespuesta esperada: 404 SESSION_NOT_FOUND."
          },
          "response": [
            {
              "name": "404 SESSION_NOT_FOUND — IDOR protegido",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"error_code\": \"SESSION_NOT_FOUND\",\n  \"message\": \"Sesión inexistente o pertenece a otro usuario.\"\n}"
            }
          ]
        },
        {
          "name": "DELETE /history/{id} con token de user2 — debe devolver 404",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token_user2}}" }
            ],
            "url": {
              "raw": "{{base_url}}/history/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["history", "{{session_id}}"]
            },
            "description": "Intentar borrar sesión de user1 con token de user2. Respuesta esperada: 404."
          },
          "response": [
            {
              "name": "404 SESSION_NOT_FOUND — IDOR protegido",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"error_code\": \"SESSION_NOT_FOUND\",\n  \"message\": \"Sesión inexistente o pertenece a otro usuario.\"\n}"
            }
          ]
        }
      ]
