              "body": "{\n  \"error_code\": \"SESSION_NOT_FOUND\",\n  \"message\": \"Sesión inexistente o pertenece a otro usuario.\"\n}"
            }
          ]
        },
        {
          "name": "DELETE /history/{id} — eliminar sesión",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/history/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["history", "{{session_id}}"]
            }
          },
          "response": [
            {
              "name": "200 OK — eliminada",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"message\": \"Sesión eliminada correctamente.\"\n}"
            },
            {
              "name": "404 Sesión no encontrada",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"error_code\": \"SESSION_NOT_FOUND\",\n  \"message\": \"Sesión inexistente o pertenece a otro usuario.\"\n}"
            }
          ]
        }
      ]
    },
